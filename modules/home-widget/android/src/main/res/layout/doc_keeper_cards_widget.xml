<?xml version="1.0" encoding="utf-8"?>
<!-- The pinned cards widget (CardsWidgetProvider). Four fixed rows, shown as there are pinned cards:
     home screen widgets can only use simple views. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/doc_keeper_widget"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/doc_keeper_widget_bg"
  android:orientation="vertical"
  android:padding="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/doc_keeper_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:paddingStart="4dp"
      android:text="@string/doc_keeper_widget_title"
      android:textColor="@color/doc_keeper_widget_text"
      android:textSize="16sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/doc_keeper_add"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:background="@drawable/doc_keeper_widget_add"
      android:contentDescription="@string/doc_keeper_widget_add"
      android:gravity="center"
      android:text="+"
      android:textColor="@color/doc_keeper_widget_on_accent"
      android:textSize="22sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/doc_keeper_message"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:text="@string/doc_keeper_widget_empty"
    android:textColor="@color/doc_keeper_widget_muted"
    android:textSize="13sp" />

  <LinearLayout
    android:id="@+id/doc_keeper_row_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/doc_keeper_widget_row"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:visibility="gone">
    <TextView
      android:id="@+id/doc_keeper_name_0"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/doc_keeper_widget_text"
      android:textSize="15sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/doc_keeper_note_0"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/doc_keeper_widget_muted"
      android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/doc_keeper_row_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/doc_keeper_widget_row"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:visibility="gone">
    <TextView
      android:id="@+id/doc_keeper_name_1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/doc_keeper_widget_text"
      android:textSize="15sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/doc_keeper_note_1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/doc_keeper_widget_muted"
      android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/doc_keeper_row_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/doc_keeper_widget_row"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:visibility="gone">
    <TextView
      android:id="@+id/doc_keeper_name_2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/doc_keeper_widget_text"
      android:textSize="15sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/doc_keeper_note_2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/doc_keeper_widget_muted"
      android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/doc_keeper_row_3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/doc_keeper_widget_row"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:visibility="gone">
    <TextView
      android:id="@+id/doc_keeper_name_3"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/doc_keeper_widget_text"
      android:textSize="15sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/doc_keeper_note_3"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/doc_keeper_widget_muted"
      android:textSize="12sp" />
  </LinearLayout>

</LinearLayout>
